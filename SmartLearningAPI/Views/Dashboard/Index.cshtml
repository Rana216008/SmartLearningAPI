@model DashboardViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>لوحة التحكم | الأم</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/dashboard-index.css" asp-append-version="true" />
</head>
<body>

    <div class="app-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo-icon">🤖</div>
                <h2>روبوتي</h2>
                <p>لوحة التحكم</p>
            </div>

            <nav class="sidebar-nav">
                <a href="#" class="nav-item active">
                    <i class="fas fa-sliders-h"></i>
                    <span>الإعدادات</span>
                </a>
                <a href="/Dashboard/Analytics" class="nav-item">
                    <i class="fas fa-chart-line"></i>
                    <span>عرض الأداء</span>
                </a>
                <a href="javascript:void(0)" class="nav-item" onclick="openHelpModal()">
                    <i class="fas fa-question-circle"></i>
                    <span>مساعدة</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="status-indicator">
                    <span class="status-dot"></span>
                    <span>متصل بالروبوت</span>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- HERO HEADER -->
            <header class="content-header">
                <h1>مرحباً بكِ في لوحة تحكم الأم 🌸</h1>
                <p>اختيار المحتوى وطريقة تفاعل الروبوت مع طفلك</p>
                <a href="/Dashboard/Analytics" class="btn-primary">
                    <i class="fas fa-chart-line"></i>
                    عرض رحلة الطفل التعليمية
                </a>
            </header>

            <!-- CONTROL CARDS -->
            <div class="control-cards">

                <!-- CARD: Content Type -->
                <div class="card">
                    <div class="card-head">
                        <div class="card-icon">📂</div>
                        <div>
                            <h3>نوع المحتوى التعليمي</h3>
                            <p>اختيار اللغة أو التصنيف</p>
                        </div>
                    </div>
                    <div class="button-grid">
                        <button class="ctrl-btn @(Model.ActiveCategory == "Arabic" ? "active" : "")"
                                onclick="updateMode('Category','Arabic',this)">
                            <span class="btn-emoji">🇸🇦</span>
                            <span class="btn-label">عربي</span>
                            <span class="btn-sub">Arabic</span>
                        </button>
                        <button class="ctrl-btn @(Model.ActiveCategory == "English" ? "active" : "")"
                                onclick="updateMode('Category','English',this)">
                            <span class="btn-emoji">🇺🇸</span>
                            <span class="btn-label">إنجليزي</span>
                            <span class="btn-sub">English</span>
                        </button>
                        <button class="ctrl-btn @(Model.ActiveCategory == "Colors" ? "active" : "")"
                                onclick="updateMode('Category','Colors',this)">
                            <span class="btn-emoji">🎨</span>
                            <span class="btn-label">ألوان</span>
                            <span class="btn-sub">Colors</span>
                        </button>
                        <button class="ctrl-btn @(Model.ActiveCategory == "All" ? "active" : "")"
                                onclick="updateMode('Category','All',this)">
                            <span class="btn-emoji">🌍</span>
                            <span class="btn-label">الكل</span>
                            <span class="btn-sub">All Cards</span>
                        </button>
                    </div>
                </div>

                <!-- CARD: Robot Mode -->
                <div class="card">
                    <div class="card-head">
                        <div class="card-icon">🤖</div>
                        <div>
                            <h3>وضع تشغيل الروبوت</h3>
                            <p>التحكم بطريقة تفاعل الروبوت</p>
                        </div>
                    </div>
                    <div class="button-grid">
                        <button class="ctrl-btn @(Model.ActiveMode == "Learn" ? "active" : "")"
                                onclick="updateMode('Status','Learn',this)">
                            <span class="btn-emoji">🎓</span>
                            <span class="btn-label">وضع التعليم</span>
                            <span class="btn-sub">Learning Mode</span>
                        </button>
                        <button class="ctrl-btn @(Model.ActiveMode == "Exam" ? "active" : "")"
                                onclick="updateMode('Status','Exam',this)">
                            <span class="btn-emoji">📜</span>
                            <span class="btn-label">وضع الاختبار</span>
                            <span class="btn-sub">Exam Mode</span>
                        </button>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- HELP MODAL -->
    <div id="helpModal" class="modal-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); backdrop-filter:blur(10px); z-index:999; justify-content:center; align-items:center;">
        <div class="modal-content" style="background:rgba(20,18,40,0.9); border:1px solid #00e5ff; border-radius:2rem; padding:2rem; max-width:500px; width:90%; color:#fff; text-align:center;">
            <span class="modal-close" onclick="closeHelpModal()" style="position:absolute; top:10px; right:15px; font-size:1.8rem; cursor:pointer; color:#ff2a6d;">&times;</span>
            <h2 style="color:#00e5ff;">🤖 مركز المساعدة</h2>
            <p style="margin:1rem 0;">مرحباً بكِ في لوحة تحكم الروبوت التعليمي!</p>
            <ul style="text-align:right; list-style:none; padding:0;">
                <li>📂 <strong>نوع المحتوى التعليمي:</strong> اختاري اللغة أو التصنيف الذي تريدين أن يتفاعل معه طفلك.</li>
                <li>
                    🤖 <strong>وضع التشغيل:</strong>
                    <ul>
                        <li>🎓 وضع التعليم – يعرض الكرت ويشغل الصوت التعليمي.</li>
                        <li>📜 وضع الاختبار – يسأل الطفل سؤالاً وينتظر الإجابة الصحيحة.</li>
                    </ul>
                </li>
                <li>📊 <strong>عرض الأداء:</strong> يظهر لكِ تقريراً كاملاً عن تقدم طفلك.</li>
            </ul>
            <p style="margin-top:1rem;">لأي استفسار، يمكنك التواصل مع الدعم الفني.</p>
            <button onclick="closeHelpModal()" style="margin-top:1rem; padding:0.5rem 2rem; border-radius:2rem; background:#00e5ff; color:#000; border:none; font-weight:bold; cursor:pointer;">حسناً</button>
        </div>
    </div>

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>